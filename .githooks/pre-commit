#!/usr/bin/env bash
# _ref/ is the read-only reference: nothing under it may change in a commit.
# Copy what you need into the working project (engine/asm/swreg/) instead.
head_ref=$(git rev-parse --verify --quiet 'HEAD:_ref' || true)
index_ref=$(git rev-parse --verify --quiet "$(git write-tree):_ref" 2>/dev/null || true)
if [ "$head_ref" != "$index_ref" ]; then
    echo "pre-commit: refusing to change _ref/ (read-only reference)." >&2
    git diff --cached --name-status -- _ref/ >&2
    echo "If you really mean it: git commit --no-verify" >&2
    exit 1
fi

# Text hygiene for staged files (trailing newline, no trailing
# whitespace); see tools/check-text-hygiene.sh. The _ref/ guard above
# runs first so reference files never reach this check.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

files=()
while IFS= read -r file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if ! bash "$ROOT/tools/check-text-hygiene.sh" "${files[@]}"; then
    echo "Refusing commit: end every text file with a newline and strip trailing whitespace."
    exit 1
fi

exit 0
